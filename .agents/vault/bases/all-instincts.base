filters:
  and:
    - 'file.ext == "md"'
    - or:
        - 'file.folder.split("/").slice(-1)[0] == "instincts"'
        - 'file.folder.split("/").slice(-1)[0] == "global-instincts"'

formulas:
  days_since_seen: 'if(last_seen, (today() - date(last_seen)).days, "")'
  project: 'file.folder.split("/").slice(-2)[0]'

properties:
  formula.days_since_seen:
    displayName: "Days Since Seen"
  formula.project:
    displayName: "Project / Scope"

views:
  - type: table
    name: "All Instincts (All Projects)"
    filters:
      and:
        - 'status != "pruned"'
    order:
      - file.name
      - confidence
      - category
      - applied
      - formula.project
      - formula.days_since_seen
    groupBy:
      property: confidence
      direction: DESC
    summaries:
      applied: Sum

  - type: table
    name: "By Project"
    filters:
      and:
        - 'status != "pruned"'
    order:
      - file.name
      - confidence
      - category
      - applied
    groupBy:
      property: formula.project
      direction: ASC
