filters:
  and:
    - file.inFolder("decisions")
    - 'file.ext == "md"'

formulas:
  age_days: '(today() - date(date)).days'
  status_icon: 'if(status == "active", "✅", if(status == "superseded", "🔄", "⚠️"))'

properties:
  formula.status_icon:
    displayName: ""
  formula.age_days:
    displayName: "Age (days)"
  domain:
    displayName: "Domain"

views:
  - type: table
    name: "All Decisions"
    order:
      - formula.status_icon
      - id
      - file.name
      - date
      - domain
      - status
      - formula.age_days
    groupBy:
      property: domain
      direction: ASC

  - type: cards
    name: "Decision Cards"
    order:
      - file.name
      - domain
      - date
      - formula.status_icon
