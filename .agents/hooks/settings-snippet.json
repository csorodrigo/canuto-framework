{
  "_comment": "Merge this into ~/.claude/settings.json. Each array entry is a hook group (Claude Code v1.x format).",
  "hooks": {
    "ExitPlanMode": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/plan-review.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-save.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-save.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ast-grep": {
      "command": "npx",
      "args": ["-y", "@ast-grep/mcp"],
      "type": "stdio"
    }
  }
}
