{
  "name": "Cost Dashboard — Provider Token Tracking",
  "description": "Tracks Opus vs Codex token usage, estimated costs, and savings over time",
  "source": "vault/metrics",
  "filter": {
    "type": "review-score OR metric"
  },
  "columns": [
    { "field": "date", "label": "Date", "type": "date" },
    { "field": "provider_tokens.claude", "label": "Claude Tokens", "type": "number" },
    { "field": "provider_tokens.codex", "label": "Codex Tokens", "type": "number" },
    { "field": "estimated_cost.claude", "label": "Claude Cost", "type": "number", "format": "$0.00" },
    { "field": "estimated_cost.codex", "label": "Codex Cost", "type": "number", "format": "$0.00" },
    { "field": "savings_pct", "label": "Savings %", "type": "number", "format": "0%" },
    { "field": "tasks_delegated", "label": "Tasks Delegated", "type": "number" },
    { "field": "escalations", "label": "Escalations", "type": "number" }
  ],
  "sort": { "field": "date", "order": "desc" },
  "groupBy": null,
  "notes": "Populated by session-save.sh hook. Each session appends a row with provider-specific metrics."
}
