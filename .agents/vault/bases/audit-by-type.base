filters:
  and:
    - 'file.folder.split("/").slice(-1)[0] == "audit"'
    - 'file.ext == "md"'

formulas:
  event_icon: 'if(event == "HANDOFF", "🔄", if(event == "GATE", "🚪", if(event == "REWORK", "♻️", if(event == "ESCALATION", "⬆️", if(event == "SESSION_START", "▶️", if(event == "SESSION_END", "⏹️", "📌"))))))'

properties:
  formula.event_icon:
    displayName: ""
  event:
    displayName: "Event Type"
  actor:
    displayName: "Actor"
  impact:
    displayName: "Impact"

views:
  - type: table
    name: "By Event Type"
    order:
      - formula.event_icon
      - event
      - date
      - actor
      - file.name
      - impact
    groupBy:
      property: event
      direction: ASC

  - type: table
    name: "By Actor"
    order:
      - actor
      - event
      - date
      - file.name
    groupBy:
      property: actor
      direction: ASC

  - type: list
    name: "Timeline"
    order:
      - date
      - formula.event_icon
      - file.name
