filters:
  and:
    - file.inFolder("instincts")
    - 'file.ext == "md"'

formulas:
  days_since_seen: 'if(last-seen, (today() - date(last-seen)).days, "")'
  confidence_icon: 'if(confidence == "high", "🔴", if(confidence == "medium", "🟡", "🟢"))'

properties:
  formula.confidence_icon:
    displayName: ""
  formula.days_since_seen:
    displayName: "Days Since Seen"
  confidence:
    displayName: "Confidence"
  category:
    displayName: "Category"
  applied:
    displayName: "Times Applied"

views:
  - type: table
    name: "Active Instincts"
    filters:
      and:
        - 'status == "active"'
    order:
      - formula.confidence_icon
      - file.name
      - confidence
      - category
      - applied
      - formula.days_since_seen
    groupBy:
      property: confidence
      direction: DESC
    summaries:
      applied: Sum

  - type: table
    name: "Pruned / Promoted"
    filters:
      or:
        - 'status == "pruned"'
        - 'status == "promoted"'
    order:
      - file.name
      - status
      - promoted-to
