{
  "_comment": "Merge this into ~/.claude/settings.json. Valid Claude Code hook events: PreToolUse, PostToolUse, Stop, Notification.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-save.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-save.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ast-grep": {
      "command": "npx",
      "args": ["-y", "@ast-grep/mcp"],
      "type": "stdio"
    }
  }
}
