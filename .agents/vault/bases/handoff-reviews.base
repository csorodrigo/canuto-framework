filters:
  and:
    - 'file.folder.split("/").slice(-1)[0] == "handoffs"'
    - 'file.ext == "md"'

properties:
  task_id:
    displayName: "Task ID"
  thread_id:
    displayName: "Thread ID"
  source_session:
    displayName: "Source Session"
  context_package:
    displayName: "Context Package"

views:
  - type: table
    name: "Active Handoffs"
    filters:
      and:
        - 'status == "active"'
    order:
      - file.name
      - task_id
      - provider
      - thread_id
      - source_session
      - context_package

  - type: table
    name: "All Handoffs"
    order:
      - file.name
      - task_id
      - provider
      - status
      - thread_id
