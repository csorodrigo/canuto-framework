filters:
  and:
    - file.inFolder("metrics")
    - 'file.ext == "md"'

formulas:
  project: 'file.folder'
  session_date: 'file.ctime.format("YYYY-MM-DD")'

properties:
  formula.project:
    displayName: "Project"
  formula.session_date:
    displayName: "Date"

views:
  - type: table
    name: "All Metrics (All Projects)"
    order:
      - formula.session_date
      - formula.project
      - review_verdict
      - must_fix_count
      - rework_cycles
      - tasks_completed
      - goals_achieved
    groupBy:
      property: formula.project
      direction: ASC
    summaries:
      tasks_completed: Sum
      rework_cycles: Sum
      must_fix_count: Sum

  - type: table
    name: "Timeline"
    order:
      - formula.session_date
      - formula.project
      - review_verdict
      - tasks_completed
      - rework_cycles
    summaries:
      tasks_completed: Sum
