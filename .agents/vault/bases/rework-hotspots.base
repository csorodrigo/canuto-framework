filters:
  and:
    - 'file.folder.split("/").slice(-1)[0] == "pending"'
    - 'file.ext == "md"'
    - 'rework-count > 0 || retry-count > 0 || !!duplicate-of'

formulas:
  heat: 'if(rework-count >= 3, "🔥", if(rework-count >= 1, "♻️", "•"))'
  attention: 'rework-count + retry-count'

properties:
  formula.heat:
    displayName: ""
  formula.attention:
    displayName: "Attention Score"

views:
  - type: table
    name: "Hotspots"
    order:
      - formula.heat
      - formula.attention
      - rework-count
      - retry-count
      - provider
      - owner
      - file.name
    groupBy:
      property: provider
      direction: ASC
