{
  "_comment": "Adicionar este bloco à chave 'hooks' em ~/.claude/settings.json (formato novo)",
  "hooks": {
    "ExitPlanMode": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/plan-review.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ast-grep": {
      "command": "npx",
      "args": ["-y", "@ast-grep/mcp"],
      "type": "stdio"
    }
  }
}
