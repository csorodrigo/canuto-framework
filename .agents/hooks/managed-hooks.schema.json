{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canuto.dev/schemas/managed-hooks.schema.json",
  "title": "Canuto managed hooks manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "surface", "entries"],
  "properties": {
    "$schema": { "const": "./managed-hooks.schema.json" },
    "schemaVersion": { "const": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "status",
          "origin",
          "event",
          "matcher",
          "timeout",
          "role",
          "command",
          "expectedHash",
          "mode"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
          "version": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["active", "retired"] },
          "origin": { "type": "string", "minLength": 1 },
          "event": { "type": "string", "minLength": 1 },
          "matcher": { "type": "string" },
          "timeout": { "type": ["integer", "null"], "minimum": 1 },
          "role": { "enum": ["gate", "advisory", "observer", "automation"] },
          "command": { "type": "string", "pattern": "^~/(?!.*\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "expectedHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mode": { "const": "0755" }
        }
      }
    }
  }
}
