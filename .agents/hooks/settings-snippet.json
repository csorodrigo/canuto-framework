{
  "_comment": "Merge this into ~/.claude/settings.json. Events: SessionStart, PreToolUse, PostToolUse, Stop, Notification.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-collision-check.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/codex-pretool-guard.sh",
            "timeout": 240
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-commands.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-commit-branch-check.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-files.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/fingerprint-gate.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-claim-grep.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-tests-for-pr.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_take_screenshot|mcp__claude-in-chrome__computer",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/screenshot-guard.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validation-mark.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validation-clear.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/retry-detect.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/posttooluse-universal.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-finalize.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-save.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-save.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ast-grep": {
      "command": "npx",
      "args": ["-y", "@ast-grep/mcp"],
      "type": "stdio"
    },
    "openbrand": {
      "command": "npx",
      "args": ["-y", "openbrand-mcp"],
      "type": "stdio"
    },
    "context-hub": {
      "command": "npx",
      "args": ["-y", "@aisuite/chub-mcp"],
      "type": "stdio"
    }
  }
}
