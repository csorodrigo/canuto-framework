# Environment variables
.env
.env.local
.env.*.local

# Secrets and credentials
*.pem
*.key
credentials.json
service-account.json

# OS files
.DS_Store
Thumbs.db

# Dependencies
node_modules/
vendor/
venv/
__pycache__/

# Canuto Framework — session snapshots (local only)
.agents/vault/.snapshots/
.agents/vault/.last-save-timestamp
.agents/.cache/

# Build artifacts
dist/
build/
.next/
.turbo/
*.tsbuildinfo
.agents/tmp/

# Hook runtime state (produced by validation/retry/fingerprint hooks)
.agents/vault/audit/retry-counter.json
.agents/vault/audit/validation-pending.json
.agents/vault/audit/*-SESSION_START.md

# OTLP fallback (runtime metrics state)
.agents/vault/metrics/canuto-otlp.jsonl

# Runtime event logs (fonte de verdade fica no vault de runtime, nunca no git)
.agents/vault/events/
.agents/.cache/
.agents/vault/handoffs/*-smoke-test.md
