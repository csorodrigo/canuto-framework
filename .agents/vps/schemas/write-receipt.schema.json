{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canuto.local/schemas/write-receipt.schema.json",
  "title": "Canuto Vault Write Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "envelope_sha256",
    "source_file",
    "status",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string" },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_file": { "type": "string" },
    "status": { "enum": ["applied", "rejected"] },
    "reason": { "type": "string" },
    "operation": { "enum": ["create", "replace"] },
    "target": { "type": "string" },
    "tier": { "enum": ["hypothesis", "curated"] },
    "before_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git": {
      "type": "object",
      "properties": {
        "head_before": { "type": ["string", "null"] },
        "commit_sha": { "type": ["string", "null"] }
      }
    },
    "publish": {
      "type": "object",
      "required": ["status", "recorded_at"],
      "properties": {
        "status": { "enum": ["not_requested", "pending", "pushed", "failed"] },
        "recorded_at": { "type": "string", "format": "date-time" },
        "detail": { "type": "string" }
      }
    },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
